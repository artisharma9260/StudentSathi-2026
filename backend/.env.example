# ------------------------------------------------------------
# StudentSathi Backend — Environment Variables
# Copy this file to `.env` and fill in real values.
# ------------------------------------------------------------

# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://studentsathi.onspace.app

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/studentsathi?retryWrites=true&w=majority

# Gemini (powers real-time scholarship search with Google Search grounding)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# JWT (used to gate the admin-only scheme write endpoints)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Logging
LOG_LEVEL=info

# Admin bootstrap (used by seed script)
ADMIN_EMAIL=admin@studentsathi.in
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Sathi Admin
